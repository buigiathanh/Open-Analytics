# --- App Supabase (this dashboard: sign-in + site list on /app) ---
# Create a project, run supabase/schema-app.sql, then copy URL + publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_APP_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_app_publishable_key

# App Secret key (Settings → API → Secret keys). Server only — saves site rows in /app after sign-in.
SUPABASE_SERVICE_ROLE_KEY=your_app_service_role_secret_key

# Public URL of this app (must match browser origin for OAuth PKCE cookies)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Cloudflare Worker URL for tracker embed snippets (data-endpoint)
NEXT_PUBLIC_TRACKER_ENDPOINT=https://your-worker.workers.dev

# OAuth sign-in: Supabase Dashboard → Authentication → URL Configuration
# Redirect URLs: http://localhost:3001/auth/callback (and production /auth/callback)
# Site URL: same origin as NEXT_PUBLIC_APP_URL
#
# Providers (Authentication → Providers):
# - Google: OAuth client; authorized redirect = https://YOUR_APP_PROJECT.supabase.co/auth/v1/callback
# - GitHub: OAuth App (not GitHub App); callback = https://YOUR_APP_PROJECT.supabase.co/auth/v1/callback
#   Additional scopes in Supabase GitHub provider: read:user user:email
#   If sign-in fails with "user profile from external provider", expose primary email on GitHub
#
# Google Search Console (separate OAuth from Supabase sign-in)
# Cloud Console → APIs & Services → Enable "Google Search Console API"
# OAuth client (Web): redirect URI must include:
#   {NEXT_PUBLIC_APP_URL}/api/integrations/google/search-console/callback
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
# Optional: HMAC secret for OAuth state (defaults to SUPABASE_SERVICE_ROLE_KEY)
# GOOGLE_OAUTH_STATE_SECRET=

# Similarweb public API (no API key). Optional: SIMILARWEB_DEBUG=1 for server logs.
# SIMILARWEB_DEBUG=1

# --- Per-website analytics (NOT in .env) ---
# When you add a site in /app, you enter YOUR Supabase project (run schema-analytics.sql there).
# tracker.js POSTs to NEXT_PUBLIC_TRACKER_ENDPOINT; the worker inserts with your Secret key.
# The dashboard reads events with your publishable key (select-only RLS).
